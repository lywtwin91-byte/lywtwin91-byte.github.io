<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_label"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_permissions"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textDndStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_not_granted"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/buttonDndAccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_dnd_access"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textBatteryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_not_granted"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/buttonBatteryExemption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_battery_exemption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/disclaimer"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>
